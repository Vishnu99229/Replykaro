TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# Approved WhatsApp Content Templates (Twilio Console → Content Template Builder).
# Required for outbound messages outside the 24-hour customer service window.
TWILIO_TEMPLATE_SID_24H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TEMPLATE_SID_2H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TEMPLATE_SID_OWNER_FLAG=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set to true only for local development. Leave unset/false in production.
SKIP_TWILIO_VALIDATION=false
ANTHROPIC_API_KEY=your_anthropic_key
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
GOOGLE_CALENDAR_ID=your_calendar_id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
PORT=3000
