# ===== BSP CONFIG =====
# Choose your WhatsApp Business Solution Provider
# Options: twilio (default). Future: gupshup, aisensy, dialog360
BSP_PROVIDER=twilio

# ===== TWILIO (used if BSP_PROVIDER=twilio) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX
# Approved Content Templates (Twilio Console → Content Template Builder).
# Required for outbound messages outside the 24-hour customer service window.
TWILIO_TEMPLATE_SID_REMINDER_24H=
TWILIO_TEMPLATE_SID_REMINDER_2H=
TWILIO_TEMPLATE_SID_OWNER_FLAG=
# Set to true only for local development. Leave unset/false in production.
SKIP_TWILIO_VALIDATION=false

# ===== GUPSHUP (future — used if BSP_PROVIDER=gupshup) =====
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=
# GUPSHUP_SOURCE_NUMBER=
# GUPSHUP_TEMPLATE_ID_REMINDER_24H=
# GUPSHUP_TEMPLATE_ID_REMINDER_2H=
# GUPSHUP_TEMPLATE_ID_OWNER_FLAG=

# ===== SHARED =====
ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
CLINIC_OWNER_PHONE=
PORT=3000
